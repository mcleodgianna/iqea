[node name="shop_area" type="Node2D"]
script = ExtResource("1_k0gjp")
dialouge = Array[String](["When are you clocking out?", "You wanna get food after this?", "Why do you get all the money that the guy pays for the furniture for?", "Why am I still here?", "I haven't showered in a week.", "Watch out for November 12th 2025.", "Good afternoon young man.", "Get more health, trust me.", "I wonder why you're playing this...", "Samer did the programming!!!", "I feel like I should grab some boba tea... nah.", "Have you played Deltarune? Try it, it's pretty good.", "Hi, I'm Jerry Dickens 3rd Esq.!", "You can delete furniture after you place it, you know that right?", "I think... I'm developing a crush on you.", "Hi I'm Kim Kardashian!", "What does skibidi mean", "Why does my kid laugh when I say my age, I'm 67.", "I missed you.", "What do you do at night?", "I think... I miss my wife.", "Make Titanfall 3", "Make Titanfall 3", "Make Titanfall 3", "Crocodile Dundee more like Crocodile's Undies! Got them!", "A penguin can be a chef too.", "You can take ducks straight from public parks!", "The mitocondria is the powerhouse of the cell.", "So this duck walked up to a lemonade stand... dum dum dum.", "hai :3", "Go badgers!", "We love respawn! (let us win)", "Average person spider eats 3 person a year factoid spider eat spider outlier i live in a cave"])

